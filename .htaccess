RewriteEngine On

# Never rewrite requests that already point to a real file or directory
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Never rewrite static assets by extension (fixes MIME type errors)
RewriteCond %{REQUEST_URI} \.(js|css|json|png|jpe?g|gif|ico|svg|woff2?|ttf|eot|webp|avif|mp4|webm|mp3|ogg|wasm)$ [NC]
RewriteRule ^ - [L]

# SPA fallback - everything else goes to index.html
RewriteRule ^ /index.html [L]

# No cache for index.html
<Files "index.html">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
  Header set Pragma "no-cache"
  Header set Expires 0
</Files>
