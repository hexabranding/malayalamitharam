RewriteEngine On

# Apache/Hostinger deployment: render article metadata before the React SPA
# fallback. This must stay above the generic index.html rewrite.
RewriteRule ^post/([^/]+)/?$ og.php?slug=$1 [L,QSA,B]
RewriteRule ^news/([^/]+)/?$ og.php?slug=$1 [L,QSA,B]

# Never rewrite requests that already point to a real file or directory
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Never rewrite static assets by extension (fixes MIME type errors)
RewriteCond %{REQUEST_URI} \.(js|css|json|png|jpe?g|gif|ico|svg|woff2?|ttf|eot|webp|avif|mp4|webm|mp3|ogg|wasm)$ [NC]
RewriteRule ^ - [L]

# SPA fallback - everything else goes to index.html
RewriteRule ^ /index.html [L]
